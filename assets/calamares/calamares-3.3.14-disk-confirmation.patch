+
+static QString
+blockDeviceAttribute( const QString& node, const QString& attribute )
+{
+    const QString sysfsPath = QStringLiteral( "/sys/class/block/%1/device/%2" )
+                                  .arg( QFileInfo( node ).fileName(), attribute );
+    QFile file( sysfsPath );
+    if ( !file.open( QIODevice::ReadOnly ) )
+    {
+        return {};
+    }
+    return QString::fromLocal8Bit( file.readAll() ).simplified();
+}
+
+QString
+ChoicePage::selectedDeviceNode() const
+{
+    const auto* device = selectedDevice();
+    return device ? device->deviceNode() : QString();
+}
+
+QString
+ChoicePage::selectedDeviceModel() const
+{
+    const auto* device = selectedDevice();
+    if ( !device || device->type() != Device::Type::Disk_Device )
+    {
+        return {};
+    }
+    const QString model = device->name().simplified();
+    return model.isEmpty() ? device->prettyName().simplified() : model;
+}
+
+QString
+ChoicePage::selectedDeviceSysfsModel() const
+{
+    return blockDeviceAttribute( selectedDeviceNode(), QStringLiteral( "model" ) );
+}
+
+QString
+ChoicePage::selectedDeviceSerial() const
+{
+    return blockDeviceAttribute( selectedDeviceNode(), QStringLiteral( "serial" ) );
+}
+
+qint64
+ChoicePage::selectedDeviceCapacity() const
+{
+    const auto* device = selectedDevice();
+    return device ? device->capacity() : 0;
+}
+
+QString
+ChoicePage::eraseConfirmationToken() const
+{
+    const QString model = selectedDeviceModel();
+    const QString node = selectedDeviceNode();
+    const qint64 capacity = selectedDeviceCapacity();
+    if ( model.isEmpty() || node.isEmpty() || capacity <= 0 )
+    {
+        return {};
+    }
+    return QStringLiteral( "ERASE %1 %2 %3" ).arg( model, QString::number( capacity ), node );
+}
+
+bool
+ChoicePage::eraseConfirmationMatches() const
+{
+    return m_config->installChoice() == InstallChoice::Erase && m_eraseConfirmationEdit
+        && !eraseConfirmationToken().isEmpty() && m_eraseConfirmationEdit->text() == eraseConfirmationToken();
 }
 

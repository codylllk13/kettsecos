+    }
+    return QString::fromLocal8Bit( file.readAll() ).simplified();
+}
+
+class DiskIdentityGuardJob final : public Calamares::Job
+{
+public:
+    DiskIdentityGuardJob( QString node,
+                          QString model,
+                          QString sysfsModel,
+                          QString serial,
+                          qint64 capacity,
+                          bool confirmationMatches )
+        : m_node( std::move( node ) )
+        , m_model( std::move( model ) )
+        , m_sysfsModel( std::move( sysfsModel ) )
+        , m_serial( std::move( serial ) )
+        , m_capacity( capacity )
+        , m_confirmationMatches( confirmationMatches )
+    {
+    }
+
+    QString prettyName() const override { return tr( "Verify selected disk identity", "@label" ); }
+    QString prettyStatusMessage() const override { return tr( "Verifying selected disk identity…", "@status" ); }
+
+    Calamares::JobResult exec() override
+    {
+        if ( !m_confirmationMatches || m_node.isEmpty() || m_model.isEmpty() || m_capacity <= 0 )
+        {
+            return Calamares::JobResult::error(
+                tr( "Disk identity confirmation is missing or no longer matches.", "@message" ) );
+        }
+
+        struct stat deviceStat {};
+        if ( ::stat( m_node.toLocal8Bit().constData(), &deviceStat ) != 0 || !S_ISBLK( deviceStat.st_mode ) )
+        {
+            return Calamares::JobResult::error(
+                tr( "The selected disk is no longer available as a block device.", "@message" ), m_node );
+        }
+
+        const int fd = ::open( m_node.toLocal8Bit().constData(), O_RDONLY | O_CLOEXEC );
+        if ( fd < 0 )
+        {
+            return Calamares::JobResult::error(
+                tr( "Cannot recheck the selected disk before partitioning.", "@message" ), m_node );
+        }
+        quint64 liveCapacity = 0;
+        const int ioctlResult = ::ioctl( fd, BLKGETSIZE64, &liveCapacity );
+        ::close( fd );
+        if ( ioctlResult != 0 || liveCapacity != static_cast< quint64 >( m_capacity ) )
+        {
+            return Calamares::JobResult::error(
+                tr( "The selected disk capacity changed after confirmation.", "@message" ), m_node );
+        }
+
+        const QString liveModel = readBlockAttribute( m_node, QStringLiteral( "model" ) );
+        const QString liveSerial = readBlockAttribute( m_node, QStringLiteral( "serial" ) );
+        if ( ( !m_sysfsModel.isEmpty() && liveModel != m_sysfsModel )
+             || ( !m_serial.isEmpty() && liveSerial != m_serial ) )
+        {
+            return Calamares::JobResult::error(
+                tr( "The selected disk identity changed after confirmation.", "@message" ), m_node );
+        }
+
+        return Calamares::JobResult::ok();
+    }
+
+private:
+    QString m_node;
+    QString m_model;
+    QString m_sysfsModel;
+    QString m_serial;
+    qint64 m_capacity;
+    bool m_confirmationMatches;
+};
+}  // namespace
 

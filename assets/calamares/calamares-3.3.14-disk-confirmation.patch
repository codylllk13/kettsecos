+void
+ChoicePage::updateEraseConfirmationDisplay()
+{
+    if ( !m_eraseConfirmationEdit || !m_eraseConfirmationLabel )
+    {
+        return;
+    }
+
+    const auto choice = m_config->installChoice();
+    if ( choice != m_lastConfirmationChoice )
+    {
+        m_eraseConfirmationEdit->clear();
+        m_lastConfirmationChoice = choice;
+    }
+
+    const QString token = eraseConfirmationToken();
+    const bool visible = choice == InstallChoice::Erase && !token.isEmpty();
+    if ( visible )
+    {
+        const QString model = selectedDeviceModel();
+        const QString node = selectedDeviceNode();
+        const qint64 capacity = selectedDeviceCapacity();
+        m_eraseConfirmationLabel->setText(
+            tr( "This will erase the entire selected disk: %1 (%2 bytes, %3). Type the exact text below to continue: %4",
+                 "@info" )
+                .arg( model, QString::number( capacity ), node, token ) );
+        m_eraseConfirmationEdit->setPlaceholderText( token );
+        m_eraseConfirmationLabel->show();
+        m_eraseConfirmationEdit->show();
+    }
+    else
+    {
+        m_eraseConfirmationLabel->hide();
+        m_eraseConfirmationEdit->hide();
+        m_eraseConfirmationEdit->clear();
+    }
